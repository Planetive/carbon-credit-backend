# EC2 Postgres (rethinkcarbon) — required for auth + primary DB
# Example: postgresql://postgres:PASSWORD@EC2_HOST:5432/rethinkcarbon
DATABASE_URL=

# JWT auth (self-hosted FastAPI; public.users)
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# CORS — comma-separated origins (optional; defaults cover rethinkcarbon.io + localhost)
# ALLOWED_ORIGINS=https://www.rethinkcarbon.io,https://rethinkcarbon.io,http://localhost:5173

# Platform admin (ESG admin dashboard; must match SPA VITE_ADMIN_PASSWORD)
ADMIN_API_KEY=

# UoP reportable parent Save — stay false until an explicit release review.
# Do not set these in production until 0017 live ledger is verified and UAT passes.
# UOP_REPORTABLE_SAVE_ENABLED=false
# Migration 0018 (emission-factor library) is prepared and must not be applied
# to production without a release review. Approved library values are immutable.

# Legacy Supabase client (optional fallback for /health and /test-db only)
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
